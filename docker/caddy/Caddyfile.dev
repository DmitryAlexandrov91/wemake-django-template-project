# development instance of reverse_proxy
# this caddy works in docker network with development
# database and backend instances.

# Email for Let's Encrypt expiration notices
{
	email {$TLS_EMAIL}
	auto_https off
}

https://{$DOMAIN_NAME}:8000 {
	# HTTPS options:
	header Strict-Transport-Security max-age=31536000;

  tls /certs/live/teamclimate.rassokha.pro/fullchain.pem /certs/live/teamclimate.rassokha.pro/privkey.pem

	# Removing some headers for improved security:
	header -Server

	rate_limit {
		distributed
		zone static {
			match {
				method GET
				path /static/* /media/*
			}
			key {remote_host}
			events 100
			window 10s
		}
		zone dynamic {
			match {
				not path /static/* /media/*
			}
			key {remote_host}
			events 10
			window 3s
		}
		log_key
	}

	# Serve static files
	handle_path /static/* {
		root * /var/www/django/static
		file_server {
			precompressed br gzip
		}
	}

	# Serve media files
	handle_path /media/* {
		root * /var/www/django/media
		file_server
	}

  # Serve Django paths
  handle /api/* {
          reverse_proxy web:8000
  }
  handle /admin/* {
          reverse_proxy web:8000
  }


  # Serve Frontend static files
  handle {
          root * /var/www/frontend
          file_server
  }

	encode gzip

	log {
		output stdout
	}
}
